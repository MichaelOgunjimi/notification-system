# Production environment template for infra/compose.prod.yml.
#
# Copy this to env/.env.production ONLY on the production host — never commit
# the real file. Local dev continues to use the root .env / .env.example and
# is untouched by this folder.
#
# NEXT_PUBLIC_* vars are baked into the web/docs JS bundle at Docker BUILD
# time (see their Dockerfile ARGs), not read at container runtime. Changing
# one requires rebuilding those images, not just restarting containers.

# Database — runs as the "db" service on the internal Docker network only.
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=__GENERATE_WITH_openssl_rand_-hex_32__
POSTGRES_DB=notification_system

# Application
APP_ENV=production
APP_DEBUG=false
APP_VERSION=0.1.0

# Auth — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=__GENERATE_ME__
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
MAGIC_LINK_TTL_SECONDS=900
MAGIC_LINK_RATE_LIMIT_PER_HOUR=5
ORGANIZATION_INVITATION_TTL_SECONDS=604800

# GitHub OAuth — use the production OAuth App; its callback URL must match BACKEND_URL
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BACKEND_URL=https://beaco-api.michaelogunjimi.com
FRONTEND_URL=https://beaco.michaelogunjimi.com
DOCS_URL=https://beaco-docs.michaelogunjimi.com
OAUTH_STATE_TTL_SECONDS=600

# Build-time only (see note above)
NEXT_PUBLIC_API_URL=https://beaco-api.michaelogunjimi.com/api/v1
NEXT_PUBLIC_DOCS_URL=https://beaco-docs.michaelogunjimi.com
NEXT_PUBLIC_SITE_URL=https://beaco.michaelogunjimi.com
NEXT_PUBLIC_WEB_URL=https://beaco.michaelogunjimi.com

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
LOG_FORMAT=json

# Rate Limiting
DEFAULT_RATE_LIMIT_PER_MIN=1000
RATE_LIMIT_WINDOW_SECONDS=60
MAX_BATCH_SIZE=1000

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400

# Email — Resend in production; no Mailpit container exists in compose.prod.yml
EMAIL_PROVIDER=resend
RESEND_API_KEY=__SET_ME__
EMAIL_FROM_ADDRESS=notifications@beaco.michaelogunjimi.com

# SMS (Twilio)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=__SET_ME__
TWILIO_AUTH_TOKEN=__SET_ME__
TWILIO_FROM_NUMBER=__SET_ME__

# Webhook
WEBHOOK_DEFAULT_TIMEOUT_SECONDS=30
WEBHOOK_MAX_REDIRECTS=3

# Retry
RETRY_MAX_RETRIES=5
RETRY_BASE_DELAY_SECONDS=10
RETRY_MAX_BACKOFF_SECONDS=600
RETRY_JITTER_ENABLED=true

# Redis & Celery — internal Docker network only, never published to the host.
# REDIS_PASSWORD is applied via `redis-server --requirepass` in compose.prod.yml;
# REDIS_URL/CELERY_* below must stay in sync with it (redis://:<password>@redis:...).
REDIS_PASSWORD=__GENERATE_WITH_openssl_rand_-hex_32__
REDIS_URL=redis://:__GENERATE_WITH_openssl_rand_-hex_32__@redis:6379/0
CELERY_BROKER_URL=redis://:__GENERATE_WITH_openssl_rand_-hex_32__@redis:6379/0
CELERY_RESULT_BACKEND=redis://:__GENERATE_WITH_openssl_rand_-hex_32__@redis:6379/1

# CORS — real production hostnames only, no localhost
CORS_ALLOWED_ORIGINS=https://beaco.michaelogunjimi.com https://beaco-docs.michaelogunjimi.com

# Cloudflare Tunnel ("beaco-prod") — token-based auth, no local config.yml/
# credentials.json needed. Ingress (which hostname maps to which internal
# service) is configured remotely via the Cloudflare API/dashboard, not here.
# Get this from: cloudflared tunnel token <tunnel-id>, or the Cloudflare API
# GET /accounts/{account_id}/cfd_tunnel/{tunnel_id}/token
TUNNEL_TOKEN=__SET_ME__
