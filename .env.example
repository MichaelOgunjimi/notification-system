# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=notification_system

# Application
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# Auth
JWT_SECRET=change-me-generate-with-secrets-token-urlsafe
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
MAGIC_LINK_TTL_SECONDS=900
MAGIC_LINK_RATE_LIMIT_PER_HOUR=5
ORGANIZATION_INVITATION_TTL_SECONDS=604800

# GitHub OAuth (the callback URL must match the GitHub OAuth App setting)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
DOCS_URL=http://localhost:3001
NEXT_PUBLIC_DOCS_URL=http://localhost:3001
NEXT_PUBLIC_WEB_URL=http://localhost:3000
OAUTH_STATE_TTL_SECONDS=600

# API
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=3000
DOCS_PORT=3001
LOG_LEVEL=info
LOG_FORMAT=console

# Rate Limiting
DEFAULT_RATE_LIMIT_PER_MIN=1000
RATE_LIMIT_WINDOW_SECONDS=60
MAX_BATCH_SIZE=1000

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400

# Email (Mailpit locally; use EMAIL_PROVIDER=resend in production)
EMAIL_PROVIDER=smtp
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM_ADDRESS=notifications@beaco.local
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# SMS (Twilio)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Webhook
WEBHOOK_DEFAULT_TIMEOUT_SECONDS=30
WEBHOOK_MAX_REDIRECTS=3

# Retry
RETRY_MAX_RETRIES=5
RETRY_BASE_DELAY_SECONDS=10
RETRY_MAX_BACKOFF_SECONDS=600
RETRY_JITTER_ENABLED=true

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Flower (Celery monitoring UI)
FLOWER_PORT=5555
FLOWER_USER=admin
FLOWER_PASSWORD=changeme
