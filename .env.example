# Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=notification_system

# Application
APP_ENV=development
APP_DEBUG=true
APP_VERSION=0.1.0

# Auth
MASTER_API_KEY=nk_change-me-generate-with-secrets-token-urlsafe

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
LOG_FORMAT=console

# Rate Limiting
DEFAULT_RATE_LIMIT_PER_MIN=1000
RATE_LIMIT_WINDOW_SECONDS=60
MAX_BATCH_SIZE=1000

# Idempotency
IDEMPOTENCY_TTL_SECONDS=86400

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM_ADDRESS=notifications@yourdomain.com

# SMS (Twilio)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Webhook
WEBHOOK_DEFAULT_TIMEOUT_SECONDS=30
WEBHOOK_MAX_REDIRECTS=3

# Retry
RETRY_MAX_RETRIES=5
RETRY_BASE_DELAY_SECONDS=10
RETRY_MAX_BACKOFF_SECONDS=600
RETRY_JITTER_ENABLED=true

# Phase 2+ (Redis / Celery)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
